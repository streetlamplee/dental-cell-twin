      <material name="alu"/>
    </visual>
  </link>
  <!-- ===== spindle side: X then Z ===== -->
  <joint name="x_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="x_carriage"/>
    <origin xyz="0.11995000000000001 0.125 0.41595"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" lower="-0.26535000000000003" upper="0.02545" velocity="0.1"/>
  </joint>
  <link name="x_carriage">
    <visual name="x_carriage">
      <origin rpy="0 0 0" xyz="0 0 0"/>
