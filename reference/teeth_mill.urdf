  </joint>
  <link name="tool_tip"/>
  <!-- ===== table side: Y then B then C ===== -->
  <!-- y_joint = Y motor counts as table travel. Motor + moves the table toward the column (+y): the user saw
       the real machine and RViz move opposite ways with -y (2026-10-21, first said "table to the front") -->
