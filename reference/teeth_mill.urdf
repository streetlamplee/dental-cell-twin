    <color rgba="0.92 0.92 0.88 1"/>
  </material>
  <material name="marker">
    <color rgba="0.85 0.15 0.10 1"/>
  </material>
  <material name="tool">
    <color rgba="0.95 0.75 0.10 1"/>
  </material>
  <!-- ===== fixed machine body ===== -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>
  <link name="base_link">
    <visual name="base_plate">
      <origin rpy="0 0 0" xyz="0 0.055812500000000015 0.02"/>
      <geometry>
        <box size="0.4908 0.5683750000000001 0.04"/>
      </geometry>
      <material name="frame"/>
    </visual>
    <visual name="column">
      <origin rpy="0 0 0" xyz="0 0.3 0.267975"/>
