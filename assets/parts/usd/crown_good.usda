#usda 1.0
(
    defaultPrim = "Part"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Part" (
    customData = {
        dictionary visiontwin = {
            string defect_kind = ""
            string ground_truth = "good"
            string part = "crown"
            string stage = "final"
            string variant = "good"
        }
    }
    prepend references = @./dental_crown.usd@
)
{
    float3 xformOp:rotateXYZ = (0, 0, 0)
    float3 xformOp:scale = (0.001, 0.001, 0.001)
    double3 xformOp:translate = (-0, -0, -0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    over "Looks"
    {
        def Material "Paint"
        {
            token outputs:surface.connect = </Part/Looks/Paint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.9, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    over "dental_crown"
    {
        over "body" (
            instanceable = false
        )
        {
            over "Mesh" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Part/Looks/Paint>
            }
        }
    }
}

