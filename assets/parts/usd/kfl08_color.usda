#usda 1.0
(
    defaultPrim = "Part"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Part" (
    customData = {
        dictionary visiontwin = {
            string defect_kind = "color"
            string ground_truth = "defect"
            string part = "kfl08"
            string stage = "final"
            string variant = "color"
        }
    }
    prepend references = @./kfl08.usd@
)
{
    float3 xformOp:rotateXYZ = (0, -90, 90)
    float3 xformOp:scale = (0.0041666664, 0.0041666664, 0.0041666664)
    double3 xformOp:translate = (-0, -0, 0.01708333191772306)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    over "Looks"
    {
        def Material "Paint"
        {
            token outputs:surface.connect = </Part/Looks/Paint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.35, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    over "KFL08"
    {
        over "Case"
        {
            over "Case001" (
                instanceable = false
            )
            {
                over "Mesh" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Part/Looks/Paint>
                }
            }
        }
    }
}

